<Window x:Class="Forti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Forti.UI"
        mc:Ignorable="d"
        Title="Skyfall Royale" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B132B">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LAYER 1: Gradient Sky Backdrop -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                    <GradientStop Color="#C4E0F9" Offset="0.0"/>
                    <GradientStop Color="#6EA8E8" Offset="0.35"/>
                    <GradientStop Color="#2B66B1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- LAYER 2: Full-Window Viewport3D -->
        <Viewport3D x:Name="MainViewport" Focusable="True"/>

        <!-- LAYER 3: In-Game HUD Overlay -->
        <Grid x:Name="HudLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- Center Reticle / Crosshair -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#DDFFFFFF"/>
                <Ellipse Width="20" Height="20" Stroke="#66FFFFFF" StrokeThickness="1"/>
            </Grid>

            <!-- Top Header: Alive Counter & Storm Status -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                <Border Background="#A0000000" CornerRadius="4" Padding="16,8" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ALIVE: " Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="HudAliveText" Text="10" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" Margin="0,0,20,0"/>
                        <TextBlock Text="STORM: " Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="HudStormText" Text="Waiting (30s)" Foreground="#D070FF" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Left: Health & Shield Vitals -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24" Width="260">
                <!-- Shield Bar -->
                <Grid Margin="0,0,0,6">
                    <ProgressBar x:Name="HudShieldBar" Height="14" Minimum="0" Maximum="100" Value="50"
                                 Foreground="#00B0FF" Background="#40000000" BorderBrush="#20FFFFFF"/>
                    <TextBlock x:Name="HudShieldText" Text="SHIELD 50" Foreground="#FFFFFF" FontWeight="Bold"
                               FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Health Bar -->
                <Grid>
                    <ProgressBar x:Name="HudHealthBar" Height="18" Minimum="0" Maximum="100" Value="100"
                                 Foreground="#00E676" Background="#40000000" BorderBrush="#20FFFFFF"/>
                    <TextBlock x:Name="HudHealthText" Text="HEALTH 100" Foreground="#00240C" FontWeight="Bold"
                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Bottom Right Controls Hint -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Background="#80000000" CornerRadius="4" Padding="12,6">
                <TextBlock Text="WASD: Move | Shift: Sprint | Space: Jump | Esc: Pause | F3: Debug"
                           Foreground="#E2E8F0" FontSize="11"/>
            </Border>
        </Grid>

        <!-- LAYER 4: Screens Layer (Menu / Pause / Results) -->
        <Grid x:Name="ScreensLayer">
            <!-- 4A: Main Menu Screen -->
            <Grid x:Name="MainMenuScreen" Visibility="Visible" Background="#D00A0F1D">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SKYFALL ROYALE" FontSize="42" FontWeight="Black"
                               Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="18" Color="#00E5FF" ShadowDepth="0" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Tactical Low-Poly Battle Arena" FontSize="15" FontWeight="SemiBold"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <Button Content="START BATTLE" Style="{StaticResource MenuButtonStyle}" Click="OnStartBattleClick"/>
                    <Button Content="SETTINGS" Style="{StaticResource MenuButtonStyle}" Click="OnSettingsClick"/>
                    <Button Content="QUIT" Style="{StaticResource MenuButtonStyle}" Click="OnQuitClick"/>

                    <!-- Settings Panel (Inline) -->
                    <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#1E293B" CornerRadius="6"
                            Padding="16" Margin="0,16,0,0" Width="280">
                        <StackPanel>
                            <TextBlock Text="Mouse Sensitivity" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Slider x:Name="MenuSensitivitySlider" Minimum="0.05" Maximum="0.50" Value="0.15"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="OnSensitivityChanged"/>
                            <TextBlock x:Name="MenuSensitivityLabel" Text="0.15" Foreground="#00E5FF"
                                       HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4B: Pause Screen -->
            <Grid x:Name="PauseScreen" Visibility="Collapsed" Background="#B00F172A">
                <Border Background="#1E293B" CornerRadius="10" Padding="32" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#38BDF8" BorderThickness="1.5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GAME PAUSED" FontSize="26" FontWeight="Black"
                                   Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Button Content="RESUME" Style="{StaticResource MenuButtonStyle}" Click="OnResumeClick"/>
                        <Button Content="MAIN MENU" Style="{StaticResource MenuButtonStyle}" Click="OnReturnToMenuClick"/>

                        <!-- Sensitivity Setting in Pause -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Mouse Sensitivity" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <Slider x:Name="PauseSensitivitySlider" Minimum="0.05" Maximum="0.50" Value="0.15"
                                    ValueChanged="OnSensitivityChanged"/>
                            <TextBlock x:Name="PauseSensitivityLabel" Text="0.15" Foreground="#00E5FF"
                                       HorizontalAlignment="Right" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4C: Results Screen (Victory / Defeat) -->
            <Grid x:Name="ResultsScreen" Visibility="Collapsed" Background="#C00A0F1D">
                <Border Background="#1E293B" CornerRadius="12" Padding="36" Width="400"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#00E5FF" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ResultsTitleText" Text="VICTORY ROYALE" FontSize="32" FontWeight="Black"
                                   Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ResultsSubText" Text="You are the last champion standing!"
                                   Foreground="#E2E8F0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Button Content="PLAY AGAIN" Style="{StaticResource MenuButtonStyle}" Click="OnPlayAgainClick"/>
                        <Button Content="MAIN MENU" Style="{StaticResource MenuButtonStyle}" Click="OnReturnToMenuClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- LAYER 5: Debug Overlay (F3) -->
        <ui:DebugOverlay x:Name="DebugView" Visibility="Collapsed"/>
    </Grid>
</Window>
